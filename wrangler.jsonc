{
  // beatass — one Worker serves the site AND the API.
  //
  //   /            -> public/index.html  (the built site, static, free bandwidth)
  //   /api/*       -> src/index.js       (send, block, report)
  //   /media/*     -> R2                 (the GIFs and MP4s; R2 charges nothing to download)
  //
  // Static files are matched first; anything that isn't a file falls through
  // to the Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beatass",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // The real address. "custom_domain": true tells Cloudflare to own the DNS
  // record for these names itself, so the site can never drift out of sync
  // with a hand-made A record. Declared here rather than clicked in the
  // dashboard so that a fresh deploy from CI re-asserts it every time.
  "routes": [
    { "pattern": "beatass.com", "custom_domain": true },
    { "pattern": "www.beatass.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve the files exactly as they are named. Without this, Cloudflare
    // strips the .html and redirects /privacy.html -> /privacy, so every
    // internal link and every sitemap entry would cost a redirect hop and
    // Google would report the listed URLs as "page with redirect".
    "html_handling": "none"
  },

  // the GIFs and MP4s
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beatass-media"
    }
  ],

  // confessions + the block list
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beatass-db",
      "database_id": "a9133d8f-4232-4945-99ee-0cbb9c072c77"
    }
  ],

  // rate limiting, keyed by sender IP
  "kv_namespaces": [
    {
      "binding": "RATE",
      "id": "54544f05b7204b5ca917b0490ef833f8"
    }
  ],

  "vars": {
    // Until beatass.com is verified inside Resend, mail can only go to the
    // address that owns the Resend account, and only from a resend.dev
    // address. The moment Resend shows the domain verified, this becomes
    // "Someone <someone@beatass.com>" — the name is what the recipient reads
    // first, so it carries the weight, not the letters before the @.
    "MAIL_FROM": "beatass <onboarding@resend.dev>",

    // Where a reply lands. Unlike the from address this needs no Resend
    // verification, so it can be the real address today. Cloudflare Email
    // Routing forwards it to Sanjay's inbox.
    "MAIL_REPLY_TO": "someone@beatass.com",

    "SITE_URL": "https://beatass.com"
  },

  "observability": {
    "enabled": true
  }
}
