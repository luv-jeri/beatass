email-preview.html

# classifier verdicts - these contain the confessions themselves, local only
content/classify/

# confessions pulled down for posting - somebody's message, never committed
content/instagram/q-*

# Instagram DM notifier runtime state (which messages were DM'd) - local only
content/instagram/.notified.json
